# Rename to pyproject.toml in a dedicated implementation PR after approval.

[project]
name = "atlas"
version = "0.0.0"
description = "Atlas DevOS runtime"
requires-python = ">=3.11"
dependencies = []

[project.optional-dependencies]
dev = [
    "pytest>=8.0",
]
vision = [
    "opencv-python-headless>=4.8",
    "torch",
    "torchvision",
    "Pillow",
    "numpy",
]

[tool.pytest.ini_options]
testpaths = ["tests"]
python_files = ["test_*.py"]
