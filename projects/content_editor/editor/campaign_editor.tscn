[gd_scene format=3]

[ext_resource type="Script" path="res://editor/campaign_editor.gd" id="1"]

[node name="CampaignEditor" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="MainLayout" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Header" type="Label" parent="MainLayout"]
layout_mode = 2
text = "Campaign Editor"

[node name="Body" type="HBoxContainer" parent="MainLayout"]
layout_mode = 2
size_flags_vertical = 3

[node name="EditorPanel" type="PanelContainer" parent="MainLayout/Body"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="Fields" type="VBoxContainer" parent="MainLayout/Body/EditorPanel"]
layout_mode = 2
size_flags_horizontal = 3

[node name="NameEdit" type="LineEdit" parent="MainLayout/Body/EditorPanel/Fields"]
layout_mode = 2
placeholder_text = "Campaign Name"

[node name="SaveScopeNotice" type="Label" parent="MainLayout/Body/EditorPanel/Fields"]
layout_mode = 2
text = "Changes are committed to Content Editor SQLite immediately. Use IMPORT / PUBLISH > Publish Content Editor DB to apply changes to Runtime."

[node name="StagesLabel" type="Label" parent="MainLayout/Body/EditorPanel/Fields"]
layout_mode = 2
text = "Campaign Stages"

[node name="StageList" type="ItemList" parent="MainLayout/Body/EditorPanel/Fields"]
custom_minimum_size = Vector2(0, 240)
layout_mode = 2
size_flags_vertical = 3
select_mode = 0

[node name="StageActions" type="HBoxContainer" parent="MainLayout/Body/EditorPanel/Fields"]
layout_mode = 2

[node name="AddStageButton" type="Button" parent="MainLayout/Body/EditorPanel/Fields/StageActions"]
layout_mode = 2
text = "+ Add Stage"

[node name="DeleteStageButton" type="Button" parent="MainLayout/Body/EditorPanel/Fields/StageActions"]
layout_mode = 2
text = "Delete Selected Stage"
disabled = true

[node name="SelectedStageLabel" type="Label" parent="MainLayout/Body/EditorPanel/Fields"]
layout_mode = 2
text = "Select a campaign stage"

[node name="SelectedStageFields" type="VBoxContainer" parent="MainLayout/Body/EditorPanel/Fields"]
layout_mode = 2

[node name="SourceStageRow" type="HBoxContainer" parent="MainLayout/Body/EditorPanel/Fields/SelectedStageFields"]
layout_mode = 2

[node name="SourceStageLabel" type="Label" parent="MainLayout/Body/EditorPanel/Fields/SelectedStageFields/SourceStageRow"]
layout_mode = 2
text = "Stage Data"
custom_minimum_size = Vector2(130, 0)

[node name="SourceStageOption" type="OptionButton" parent="MainLayout/Body/EditorPanel/Fields/SelectedStageFields/SourceStageRow"]
layout_mode = 2
size_flags_horizontal = 3

[node name="MissionRow" type="HBoxContainer" parent="MainLayout/Body/EditorPanel/Fields/SelectedStageFields"]
layout_mode = 2

[node name="MissionLabel" type="Label" parent="MainLayout/Body/EditorPanel/Fields/SelectedStageFields/MissionRow"]
layout_mode = 2
text = "Mission"
custom_minimum_size = Vector2(130, 0)

[node name="MissionOption" type="OptionButton" parent="MainLayout/Body/EditorPanel/Fields/SelectedStageFields/MissionRow"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Buttons" type="HBoxContainer" parent="MainLayout/Body/EditorPanel/Fields"]
layout_mode = 2

[node name="ReloadButton" type="Button" parent="MainLayout/Body/EditorPanel/Fields/Buttons"]
layout_mode = 2
text = "Reload"


[node name="Status" type="Label" parent="MainLayout"]
layout_mode = 2
text = "Ready"
