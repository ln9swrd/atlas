[resource]
script = ExtResource("1_game_settings")
towers = Array[ExtResource("2_tower_data") ]([SubResource("Resource_tower_data"), SubResource("Resource_ice_tower_data"), SubResource("Resource_lightning_tower_data")])
enemies = Array[ExtResource("3_enemy_data") ]([SubResource("Resource_enemy_data"), SubResource("Resource_fast_enemy_data"), SubResource("Resource_heavy_enemy_data"), SubResource("Resource_boss_enemy_data")])
waves = Array[ExtResource("4_wave_data") ]([SubResource("Resource_wave_data"), SubResource("Resource_wave_2"), SubResource("Resource_wave_3"), SubResource("Resource_wave_4")])
rewards = Array[ExtResource("5_reward_data") ]([SubResource("Resource_reward_fire_damage"), SubResource("Resource_reward_ice_slow"), SubResource("Resource_reward_lightning_unlock"), SubResource("Resource_reward_lightning_chain"), SubResource("Resource_reward_ice_damage")])
