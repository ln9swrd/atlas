{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mecha-metadata.schema.json",
  "title": "Mecha Metadata",
  "description": "ParaModel unit metadata. Flow: Identity → Archetype → Size → Traits → Visual → Body",
  "type": "object",
  "required": ["id", "name", "archetype", "size", "base_body"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "description": "Unique mecha id (filename without .json)"
    },
    "name": { "type": "string" },
    "codename": { "type": "string" },
    "version": { "type": "string" },
    "archetype": {
      "type": "string",
      "enum": ["humanoid", "quadruped", "multiped", "aircraft", "vessel", "custom"],
      "description": "Body plan; selects template (slots + rig + size primary)"
    },
    "category": {
      "type": "string",
      "enum": ["player", "enemy", "boss", "npc", "prop"]
    },
    "description": { "type": "string" },
    "size": {
      "type": "object",
      "required": ["primary", "value"],
      "properties": {
        "scale_class": {
          "type": "string",
          "enum": ["15m", "25m", "50m", "custom"],
          "description": "Label / default hint only — not the scale divisor"
        },
        "primary": {
          "type": "string",
          "enum": ["height", "length", "wingspan", "span", "beam"],
          "description": "Which dimension value measures"
        },
        "value": {
          "type": "number",
          "minimum": 0,
          "description": "Target size in meters (sf = value / template.reference_value)"
        }
      },
      "additionalProperties": false
    },
    "base_body": {
      "type": "object",
      "required": ["template", "slots"],
      "properties": {
        "template": {
          "type": "string",
          "description": "Template id, normally same as archetype (e.g. humanoid)"
        },
        "slots": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/slot_assignment"
          }
        }
      }
    },
    "parameters": {
      "type": "object",
      "description": "Traits (not size). size.value replaces parameters.height",
      "properties": {
        "mass": { "type": "number", "minimum": 0 },
        "armor_thickness": { "type": "number", "minimum": 0 },
        "mobility": { "type": "number", "minimum": 0, "maximum": 1 },
        "output": { "type": "number", "minimum": 0, "maximum": 1 },
        "height": {
          "type": "number",
          "minimum": 0,
          "description": "Deprecated; use size.value"
        }
      },
      "additionalProperties": true
    },
    "visual": {
      "type": "object",
      "properties": {
        "primary_color": { "type": "string" },
        "secondary_color": { "type": "string" },
        "accent_color": { "type": "string" },
        "style_tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "status": {
      "type": "string",
      "enum": ["concept", "wip", "prototype", "final", "deprecated"]
    },
    "created": { "type": "string" },
    "updated": { "type": "string" },
    "notes": { "type": "string" }
  },
  "additionalProperties": false,
  "definitions": {
    "slot_assignment": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "part_id": {
          "type": ["string", "null"],
          "description": "Part library id; null if empty slot"
        },
        "enabled": { "type": "boolean" },
        "mirror_source": {
          "type": ["string", "null"],
          "description": "Opposite slot id for symmetry"
        },
        "position": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3,
          "description": "Optional override of default slot position"
        },
        "rotation": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3,
          "description": "Optional override of default slot rotation (degrees)"
        }
      },
      "additionalProperties": false
    }
  }
}
