{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Base Body Slots Definition",
  "description": "ParaModel Base Body connection slots (Excelion 25m). Positions in mm (Unit Scale 0.001).",
  "version": "0.1.1",
  "type": "object",
  "properties": {
    "base_body_id": { "type": "string" },
    "scale_class": { "type": "string", "enum": ["25m", "15m", "50m", "custom"], "default": "25m" },
    "slots": { "type": "array", "items": { "$ref": "#/definitions/slot" } }
  },
  "required": ["base_body_id", "slots"],
  "definitions": {
    "slot": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "required": { "type": "boolean", "default": false },
        "connection_type": { "type": "string", "enum": ["fixed", "ball_socket", "socket", "hardpoint"] },
        "position": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3, "description": "[x,y,z] mm" },
        "rotation": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
        "scale_limit": { "type": "object", "properties": { "min": { "type": "number", "default": 0.8 }, "max": { "type": "number", "default": 1.2 } } },
        "compatible_parts": { "type": "array", "items": { "type": "string" } },
        "mirror": { "type": ["string", "null"] }
      },
      "required": ["id", "name", "connection_type"]
    }
  },
  "default_slots": [
    { "id": "head", "name": "헤드", "required": false, "connection_type": "socket", "position": [0, 1800, 0], "rotation": [0, 0, 0], "compatible_parts": ["head_*"], "mirror": null },
    { "id": "torso_upper", "name": "상체 상부", "required": true, "connection_type": "fixed", "position": [0, 1200, 0], "rotation": [0, 0, 0], "compatible_parts": ["torso_upper_*"], "mirror": null },
    { "id": "torso_lower", "name": "상체 하부", "required": true, "connection_type": "fixed", "position": [0, 700, 0], "rotation": [0, 0, 0], "compatible_parts": ["torso_lower_*"], "mirror": null },
    { "id": "arm_l", "name": "왼팔", "required": true, "connection_type": "ball_socket", "position": [-450, 1450, 0], "rotation": [0, 0, 0], "scale_limit": { "min": 0.8, "max": 1.2 }, "compatible_parts": ["arm_*"], "mirror": "arm_r" },
    { "id": "arm_r", "name": "오른팔", "required": true, "connection_type": "ball_socket", "position": [450, 1450, 0], "rotation": [0, 0, 0], "scale_limit": { "min": 0.8, "max": 1.2 }, "compatible_parts": ["arm_*"], "mirror": "arm_l" },
    { "id": "leg_l", "name": "왼다리", "required": true, "connection_type": "ball_socket", "position": [-250, 400, 0], "rotation": [0, 0, 0], "scale_limit": { "min": 0.8, "max": 1.2 }, "compatible_parts": ["leg_*"], "mirror": "leg_r" },
    { "id": "leg_r", "name": "오른다리", "required": true, "connection_type": "ball_socket", "position": [250, 400, 0], "rotation": [0, 0, 0], "scale_limit": { "min": 0.8, "max": 1.2 }, "compatible_parts": ["leg_*"], "mirror": "leg_l" },
    { "id": "backpack", "name": "백팩/윙", "required": false, "connection_type": "socket", "position": [0, 1300, -300], "rotation": [0, 0, 0], "compatible_parts": ["backpack_*", "wing_*"], "mirror": null },
    { "id": "skirt", "name": "스커트/장갑", "required": false, "connection_type": "socket", "position": [0, 550, 0], "rotation": [0, 0, 0], "compatible_parts": ["skirt_*"], "mirror": null },
    { "id": "weapon_l", "name": "왼손 무기", "required": false, "connection_type": "hardpoint", "position": [-700, 1100, 200], "rotation": [0, 0, 0], "compatible_parts": ["weapon_*"], "mirror": "weapon_r" },
    { "id": "weapon_r", "name": "오른손 무기", "required": false, "connection_type": "hardpoint", "position": [700, 1100, 200], "rotation": [0, 0, 0], "compatible_parts": ["weapon_*"], "mirror": "weapon_l" },
    { "id": "thruster", "name": "추진기", "required": false, "connection_type": "hardpoint", "position": [0, 900, -400], "rotation": [0, 0, 0], "compatible_parts": ["thruster_*"], "mirror": null }
  ]
}
