<Window x:Class="MKERP.App.InOutManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="입출고 / 재고" Width="1150" Height="720">
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal">
      <Button Content="신규" Width="80" Margin="0,0,6,0" Click="New_Click"/>
      <Button Content="저장" Width="80" Margin="0,0,6,0" Click="Save_Click"/>
      <Button Content="재고조회" Width="90" Margin="0,0,6,0" Click="Inventory_Click"/>
      <Button Content="Excel" Width="80" Margin="6,0,0,0" Click="Excel_Click"/>
      <Button Content="인쇄" Width="80" Margin="6,0,0,0" Click="Print_Click"/>
      <TextBlock Text="문서번호" VerticalAlignment="Center" Margin="12,0,4,0"/>
      <TextBlock x:Name="DocumentNoText" VerticalAlignment="Center" FontWeight="Bold"/>
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="80"/><ColumnDefinition Width="150"/><ColumnDefinition Width="80"/><ColumnDefinition Width="150"/>
        <ColumnDefinition Width="80"/><ColumnDefinition Width="220"/><ColumnDefinition Width="70"/><ColumnDefinition Width="120"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="일자" VerticalAlignment="Center"/>
      <DatePicker x:Name="MovementDateBox" Grid.Column="1" SelectedDateChanged="Date_Changed"/>
      <TextBlock Text="구분" Grid.Column="2" VerticalAlignment="Center"/>
      <ComboBox x:Name="TypeBox" Grid.Column="3" Margin="4" DisplayMemberPath="Name" SelectedValuePath="Key"/>
      <TextBlock Text="품목" Grid.Column="4" VerticalAlignment="Center"/>
      <ComboBox x:Name="ItemBox" Grid.Column="5" Margin="4" DisplayMemberPath="Name" SelectedValuePath="Id"/>
      <TextBlock Text="수량" Grid.Column="6" VerticalAlignment="Center"/>
      <TextBox x:Name="QtyBox" Grid.Column="7" Margin="4" Text="1"/>
    </Grid>
    <TabControl x:Name="ResultsTabs" Grid.Row="2">
      <TabItem Header="입출고 내역">
        <DataGrid x:Name="MovementGrid" AutoGenerateColumns="True" IsReadOnly="True"/>
      </TabItem>
      <TabItem Header="재고현황">
        <DataGrid x:Name="InventoryGrid" AutoGenerateColumns="True" IsReadOnly="True"/>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
