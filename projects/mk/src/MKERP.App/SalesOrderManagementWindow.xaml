<UserControl x:Class="MKERP.App.SalesOrderManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Width="1100" Height="700">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="150"/>
      <RowDefinition Height="170"/><RowDefinition Height="140"/><RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal">
      <Button Content="신규 수주" Width="90" Margin="0,0,6,0" Click="New_Click"/>
      <Button Content="저장" Width="80" Margin="0,0,6,0" Click="Save_Click"/><Button Content="수정" Width="80" Margin="0,0,6,0" Click="Edit_Click"/>
      <Button Content="확정" Width="80" Margin="0,0,6,0" Click="Confirm_Click"/>
      <Button Content="출고" Width="80" Margin="0,0,6,0" Click="Process_Click"/>
      <Button Content="취소" Width="80" Margin="0,0,6,0" Click="Cancel_Click"/>
      <Button Content="엑셀" Width="80" Margin="6,0,0,0" Click="Excel_Click"/>
      <Button Content="인쇄" Width="80" Margin="6,0,0,0" Click="Print_Click"/>
      <TextBlock Text="문서번호" VerticalAlignment="Center" Margin="12,0,4,0"/>
      <TextBlock x:Name="DocumentNoText" VerticalAlignment="Center" FontWeight="Bold"/>
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="80"/><ColumnDefinition Width="220"/>
        <ColumnDefinition Width="80"/><ColumnDefinition Width="140"/>
        <ColumnDefinition Width="80"/><ColumnDefinition Width="140"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="거래처" VerticalAlignment="Center"/>
      <ComboBox x:Name="PartnerBox" Grid.Column="1" Margin="4" DisplayMemberPath="Name"
                SelectedValuePath="Id" SelectionChanged="Input_Changed"/>
      <TextBlock Text="수주일" Grid.Column="2" VerticalAlignment="Center"/>
      <DatePicker x:Name="OrderDateBox" Grid.Column="3" Margin="4" SelectedDateChanged="OrderDate_Changed"/>
      <TextBlock Text="납기일" Grid.Column="4" VerticalAlignment="Center"/>
      <DatePicker x:Name="DueDateBox" Grid.Column="5" Margin="4"/>
    </Grid>
    <Grid Grid.Row="2" Margin="0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="60"/><ColumnDefinition Width="210"/>
        <ColumnDefinition Width="55"/><ColumnDefinition Width="100"/>
        <ColumnDefinition Width="70"/><ColumnDefinition Width="100"/>
        <ColumnDefinition Width="70"/><ColumnDefinition Width="100"/>
        <ColumnDefinition Width="70"/><ColumnDefinition Width="150"/>
        <ColumnDefinition Width="80"/><ColumnDefinition Width="150"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="품목" VerticalAlignment="Center"/>
      <ComboBox x:Name="ItemBox" Grid.Column="1" Margin="4" DisplayMemberPath="Name"
                SelectedValuePath="Id" SelectionChanged="Input_Changed"/>
      <TextBlock Text="수량" Grid.Column="2" VerticalAlignment="Center"/>
      <TextBox x:Name="QtyBox" Grid.Column="3" Margin="4" Text="1"/>
      <TextBlock Text="적용단가" Grid.Column="4" VerticalAlignment="Center"/><TextBlock Text="출고수량" Grid.Column="6" VerticalAlignment="Center"/>
      <TextBox x:Name="ProcessQtyBox" Grid.Column="7" Margin="4" Text="1"/><TextBlock Text="MK Lot" Grid.Column="8" VerticalAlignment="Center"/><TextBox x:Name="ProcessMkLotBox" Grid.Column="9" Margin="4"/><TextBlock Text="거래처 Lot" Grid.Column="8" VerticalAlignment="Center"/><TextBox x:Name="ProcessPartnerLotBox" Grid.Column="9" Margin="4"/>
      <TextBlock Text="적용단가" Grid.Column="6" VerticalAlignment="Center"/>
      <TextBox x:Name="AppliedPriceBox" Grid.Column="7" Margin="4"/>
    </Grid>
    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,4,0,4">
      <Button Content="상세행 추가" Width="90" Margin="0,0,6,0" Click="AddDetail_Click"/>
      <Button Content="선택행 삭제" Width="90" Click="RemoveDetail_Click"/>
      <TextBlock Text="저장 전 상세행" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="Bold"/>
    </StackPanel>
    <DataGrid x:Name="DraftGrid" Grid.Row="4" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
      <DataGrid.Columns>
        <DataGridTextColumn Header="품목" Binding="{Binding ItemName}" Width="*"/>
        <DataGridTextColumn Header="수량" Binding="{Binding Quantity, StringFormat=N2}" Width="120"/>
        <DataGridTextColumn Header="단가" Binding="{Binding UnitPrice, StringFormat=N2}" Width="120"/>
      </DataGrid.Columns>
    </DataGrid>
    <DataGrid x:Name="DetailGrid" Grid.Row="5" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
      <DataGrid.Columns>
        <DataGridTextColumn Header="품목" Binding="{Binding ItemName}" Width="*"/>
        <DataGridTextColumn Header="주문수량" Binding="{Binding OrderQty, StringFormat=N2}" Width="120"/>
        <DataGridTextColumn Header="처리수량" Binding="{Binding ProcessedQty, StringFormat=N2}" Width="120"/>
        <DataGridTextColumn Header="잔량" Binding="{Binding RemainingQty, StringFormat=N2}" Width="120"/>
      </DataGrid.Columns>
    </DataGrid>
    <DataGrid x:Name="Grid" Grid.Row="6" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="Order_SelectionChanged">
      <DataGrid.Columns>
        <DataGridTextColumn Header="문서번호" Binding="{Binding DocumentNo}" Width="150"/>
        <DataGridTextColumn Header="수주일" Binding="{Binding OrderDate, StringFormat=yyyy-MM-dd}" Width="120"/>
        <DataGridTextColumn Header="거래처" Binding="{Binding PartnerName}" Width="100"/>
        <DataGridTextColumn Header="상태" Binding="{Binding StatusName}" Width="100"/>
        <DataGridTextColumn Header="비고" Binding="{Binding Note}" Width="*"/>
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>