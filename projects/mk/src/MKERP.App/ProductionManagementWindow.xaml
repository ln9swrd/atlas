<UserControl x:Class="MKERP.App.ProductionManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Width="1000" Height="620">
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal">
      <Button Content="신규" Width="80" Margin="0,0,6,0" Click="New_Click"/>
      <Button Content="생산완료" Width="90" Margin="0,0,6,0" Click="Save_Click"/>
      <Button Content="생산취소" Width="90" Margin="0,0,6,0" Click="Cancel_Click"/>
      <Button Content="Excel" Width="80" Margin="6,0,0,0" Click="Excel_Click"/>
      <Button Content="인쇄" Width="80" Margin="6,0,0,0" Click="Print_Click"/>
      <TextBlock Text="문서번호" VerticalAlignment="Center" Margin="12,0,4,0"/>
      <TextBlock x:Name="DocumentNoText" VerticalAlignment="Center" FontWeight="Bold"/>
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="150"/><ColumnDefinition Width="70"/><ColumnDefinition Width="220"/><ColumnDefinition Width="80"/><ColumnDefinition Width="120"/><ColumnDefinition Width="70"/><ColumnDefinition Width="120"/><ColumnDefinition Width="70"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
      <TextBlock Text="생산일" VerticalAlignment="Center"/>
      <DatePicker x:Name="ProductionDateBox" Grid.Column="1" SelectedDateChanged="Date_Changed"/>
      <TextBlock Text="품목" Grid.Column="2" VerticalAlignment="Center"/>
      <ComboBox x:Name="ItemBox" Grid.Column="3" Margin="4" DisplayMemberPath="Name" SelectedValuePath="Id"/>
      <TextBlock Text="생산수량" Grid.Column="4" VerticalAlignment="Center"/>
      <TextBox x:Name="ProductionQtyBox" Grid.Column="5" Margin="4" Text="1"/>
      <TextBlock Text="불량수량" Grid.Column="6" VerticalAlignment="Center"/>
      <TextBox x:Name="DefectQtyBox" Grid.Column="7" Margin="4" Text="0"/><TextBlock Text="MK Lot" Grid.Column="8" VerticalAlignment="Center"/><TextBox x:Name="MkLotBox" Grid.Column="9" Margin="4"/>
    </Grid>
    <DataGrid x:Name="Grid" Grid.Row="2" AutoGenerateColumns="True" IsReadOnly="True"/>
  </Grid>
</UserControl>
