<Window x:Class="MKERP.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MK ERP" Width="1200" Height="720">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="MK ERP" FontSize="28" FontWeight="Bold" />
      <TextBlock Text="기준정보 · 영업 · 구매 · 생산 · 재고" Margin="0,4,0,18" />
    </StackPanel>
    <UniformGrid Grid.Row="1" Columns="3" Rows="2" Margin="0,8,0,0">
      <Button Content="품목관리" Margin="6" Click="ItemManagement_Click" />
      <Button Content="거래처관리" Margin="6" Click="PartnerManagement_Click" />
      <Button Content="거래처별 품목관리" Margin="6" Click="PartnerItemManagement_Click" />
      <Button Content="단가관리" Margin="6" Click="PriceManagement_Click" />
      <Button Content="수주관리" Margin="6" Click="SalesOrderManagement_Click" />
      <Button Content="발주관리" Margin="6" Click="PurchaseOrderManagement_Click" />
      <Button Content="생산관리" Margin="6" Click="ProductionManagement_Click" />
      <Button Content="입출고 / 재고" Margin="6" Click="InOutManagement_Click" />
    </UniformGrid>
  </Grid>
</Window>
