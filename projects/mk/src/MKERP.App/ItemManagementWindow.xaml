<Window x:Class="MKERP.App.ItemManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="품목관리" Width="1100" Height="700">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal">
      <Button Content="조회" Width="80" Margin="0,0,6,0" Click="Search_Click" />
      <Button Content="신규" Width="80" Margin="0,0,6,0" Click="New_Click" />
      <Button Content="저장" Width="80" Margin="0,0,6,0" Click="Save_Click" />
      <Button Content="비활성" Width="80" Click="Deactivate_Click" />
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,12,0,12">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="90" /><ColumnDefinition Width="180" />
        <ColumnDefinition Width="90" /><ColumnDefinition Width="180" />
        <ColumnDefinition Width="90" /><ColumnDefinition Width="180" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="품목코드" VerticalAlignment="Center" />
      <TextBox x:Name="CodeBox" Grid.Column="1" Margin="4" />
      <TextBlock Text="품목명" Grid.Column="2" VerticalAlignment="Center" />
      <TextBox x:Name="NameBox" Grid.Column="3" Margin="4" />
      <TextBlock Text="구분" Grid.Column="4" VerticalAlignment="Center" />
      <ComboBox x:Name="CategoryBox" Grid.Column="5" Margin="4" DisplayMemberPath="Name" SelectedValuePath="Key" />
      <TextBlock Text="등급" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" />
      <ComboBox x:Name="GradeBox" Grid.Row="1" Grid.Column="1" Margin="4" DisplayMemberPath="Name" SelectedValuePath="Id" />
      <TextBlock Text="단위" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" />
      <TextBox x:Name="UnitBox" Grid.Row="1" Grid.Column="3" Margin="4" />
    </Grid>
    <DataGrid x:Name="ItemGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
              SelectionChanged="ItemGrid_SelectionChanged" HeadersVisibility="Column">
      <DataGrid.Columns>
        <DataGridTextColumn Header="품목코드" Binding="{Binding Code}" Width="150" />
        <DataGridTextColumn Header="품목명" Binding="{Binding Name}" Width="*" />
        <DataGridTextColumn Header="구분" Binding="{Binding CategoryCode}" Width="120" />
        <DataGridTextColumn Header="등급" Binding="{Binding GradeId}" Width="100" />
        <DataGridTextColumn Header="단위" Binding="{Binding UnitCode}" Width="100" />
        <DataGridCheckBoxColumn Header="사용" Binding="{Binding IsActive}" Width="70" />
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</Window>
