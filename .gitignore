*.pem

# OS / editor
.DS_Store
Thumbs.db
*.swp
*~
.idea/
*.bak
*.diff
.godot/
**/.godot/

# Logs
logs/
*.log

# MENOS build outputs
projects/menos/godot/builds/

# Large / binary assets (adjust if a project needs them tracked)
*.blend
*.blend1
*.mp3
*.flac
*.wav
# Local Voice generation tool/model cache; never commit the external runtime bundle
_ppaso_voice/
*.zip
*.glb
*.stl
*.pdb
*.bin

# Unreal generated/editor files that should never be pushed
projects/excelion/game/**/.vs/
projects/excelion/game/**/Binaries/
projects/excelion/game/**/Intermediate/
projects/excelion/game/**/Saved/

# Blender/asset directories that are too large for GitHub
projects/blender/**/*.glb
projects/blender/**/*.stl
projects/blender/**/*.fbx

# Allow this specific Blender project to be tracked
!projects/blender/shin getter robo/
!projects/blender/shin getter robo/*.blend

# ParaModel scene (Master-directed)
!projects/paramodel/
!projects/paramodel/**/*.blend

# Nested repositories (untracked as submodules)
mcp-servers/figma-context-mcp/Figma-Context-MCP
mcp-servers/servers
projects/Hunyuan3D-2
projects/Hunyuan3D-2.1
projects/wafermap-converter
unreal-5-mcp


# MK ERP customer license files
projects/mk/src/MKERP.App/bin/**/license.json

# Local MENOS database backups and generated runtime packages
projects/content_editor/data/backups/
projects/content_editor/data/runtime_registry.sqlite
projects/menos/godot/content/runtime-package-*/
projects/menos/packages/
projects/content_editor/tests/_tmp_campaign_editor_e2e.gd*
projects/content_editor/addons/godot-sqlite/bin/~libgdsqlite*.TMP
