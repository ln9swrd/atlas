# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.venv/
venv/
env/

# Node / VS Code extension
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.vsix

# Optional: compiled extension output (uncomment if out/ should not be tracked)
# projects/atlas-extension/out/

# Env & secrets
.env
.env.*
!.env.example
*.pem

# OS / editor
.DS_Store
Thumbs.db
*.swp
*~
.idea/
*.bak
*.diff

# Logs
logs/
*.log

# Large / binary assets (adjust if a project needs them tracked)
*.blend
*.blend1
*.mp3
*.flac
*.wav
*.zip

# Allow this specific Blender project to be tracked
!projects/blender/shin getter robo/
!projects/blender/shin getter robo/*.blend

# ParaModel scene (Master-directed)
!projects/paramodel/
!projects/paramodel/**/*.blend

# Nested repositories (untracked as submodules)
mcp-servers/figma-context-mcp/Figma-Context-MCP
mcp-servers/servers
projects/Hunyuan3D-2
projects/Hunyuan3D-2.1
projects/wafermap-converter
unreal-5-mcp

