{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Base Body Slots Definition",
  "description": "ParaModel Base Body connection slots for mecha parametric modeling (Excelion 25m class baseline)",
  "version": "0.1.0",
  "type": "object",
  "properties": {
    "base_body_id": {
      "type": "string",
      "description": "Unique identifier for this base body template"
    },
    "scale_class": {
      "type": "string",
      "enum": ["25m", "15m", "50m", "custom"],
      "default": "25m"
    },
    "slots": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/slot"
      }
    }
  },
  "required": ["base_body_id", "slots"],
  "definitions": {
    "slot": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique slot identifier"
        },
        "name": {
          "type": "string",
          "description": "Human readable name"
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "connection_type": {
          "type": "string",
          "enum": ["fixed", "ball_socket", "socket", "hardpoint"],
          "description": "Mechanical connection type"
        },
        "position": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3,
          "description": "Local position [x, y, z] relative to base body origin"
        },
        "rotation": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3,
          "description": "Local rotation [rx, ry, rz] in degrees"
        },
        "scale_limit": {
          "type": "object",
          "properties": {
            "min": { "type": "number", "default": 0.8 },
            "max": { "type": "number", "default": 1.2 }
          }
        },
        "compatible_parts": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of allowed part type ids"
        },
        "mirror": {
          "type": ["string", "null"],
          "description": "Opposite side slot id for symmetry"
        }
      },
      "required": ["id", "name", "connection_type"]
    }
  },
  "default_slots": [
    {
      "id": "head",
      "name": "헤드",
      "required": false,
      "connection_type": "socket",
      "position": [0, 1.8, 0],
      "rotation": [0, 0, 0],
      "compatible_parts": ["head_*"],
      "mirror": null
    },
    {
      "id": "torso_upper",
      "name": "상체 상부",
      "required": true,
      "connection_type": "fixed",
      "position": [0, 1.2, 0],
      "rotation": [0, 0, 0],
      "compatible_parts": ["torso_upper_*"],
      "mirror": null
    },
    {
      "id": "torso_lower",
      "name": "상체 하부",
      "required": true,
      "connection_type": "fixed",
      "position": [0, 0.7, 0],
      "rotation": [0, 0, 0],
      "compatible_parts": ["torso_lower_*"],
      "mirror": null
    },
    {
      "id": "arm_l",
      "name": "왼팔",
      "required": true,
      "connection_type": "ball_socket",
      "position": [-0.45, 1.45, 0],
      "rotation": [0, 0, 0],
      "scale_limit": { "min": 0.8, "max": 1.2 },
      "compatible_parts": ["arm_*"],
      "mirror": "arm_r"
    },
    {
      "id": "arm_r",
      "name": "오른팔",
      "required": true,
      "connection_type": "ball_socket",
      "position": [0.45, 1.45, 0],
      "rotation": [0, 0, 0],
      "scale_limit": { "min": 0.8, "max": 1.2 },
      "compatible_parts": ["arm_*"],
      "mirror": "arm_l"
    },
    {
      "id": "leg_l",
      "name": "왼다리",
      "required": true,
      "connection_type": "ball_socket",
      "position": [-0.25, 0.4, 0],
      "rotation": [0, 0, 0],
      "scale_limit": { "min": 0.8, "max": 1.2 },
      "compatible_parts": ["leg_*"],
      "mirror": "leg_r"
    },
    {
      "id": "leg_r",
      "name": "오른다리",
      "required": true,
      "connection_type": "ball_socket",
      "position": [0.25, 0.4, 0],
      "rotation": [0, 0, 0],
      "scale_limit": { "min": 0.8, "max": 1.2 },
      "compatible_parts": ["leg_*"],
      "mirror": "leg_l"
    },
    {
      "id": "backpack",
      "name": "백팩/윙",
      "required": false,
      "connection_type": "socket",
      "position": [0, 1.3, -0.3],
      "rotation": [0, 0, 0],
      "compatible_parts": ["backpack_*", "wing_*"],
      "mirror": null
    },
    {
      "id": "skirt",
      "name": "스커트/장갑",
      "required": false,
      "connection_type": "socket",
      "position": [0, 0.55, 0],
      "rotation": [0, 0, 0],
      "compatible_parts": ["skirt_*"],
      "mirror": null
    },
    {
      "id": "weapon_l",
      "name": "왼손 무기",
      "required": false,
      "connection_type": "hardpoint",
      "position": [-0.7, 1.1, 0.2],
      "rotation": [0, 0, 0],
      "compatible_parts": ["weapon_*"],
      "mirror": "weapon_r"
    },
    {
      "id": "weapon_r",
      "name": "오른손 무기",
      "required": false,
      "connection_type": "hardpoint",
      "position": [0.7, 1.1, 0.2],
      "rotation": [0, 0, 0],
      "compatible_parts": ["weapon_*"],
      "mirror": "weapon_l"
    },
    {
      "id": "thruster",
      "name": "추진기",
      "required": false,
      "connection_type": "hardpoint",
      "position": [0, 0.9, -0.4],
      "rotation": [0, 0, 0],
      "compatible_parts": ["thruster_*"],
      "mirror": null
    }
  ]
}
